# Path to the directory containing PDF documentation files.
# Defaults to the docs/ directory next to this file if not set.
# MCP_DOCS_DIR=/absolute/path/to/your/docs

# Server name — the identifier clients use to connect to this server.
# MCP_SERVER_NAME=access-governance-docs

# Transport mode: "stdio", "streamable-http", or "sse".
# stdio           — agent and server on the same machine (default)
# streamable-http — the recommended HTTP transport: one /mcp endpoint,
#                   works behind load balancers and Kubernetes services
# sse             — legacy HTTP transport (two endpoints + a long-lived
#                   stream); kept for rollback only
# MCP_TRANSPORT=streamable-http

# Host and port for the HTTP transports (ignored for stdio).
# Set host to 0.0.0.0 to accept connections from other machines.
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# Stateless streamable-http (default true): every request carries all
# it needs, so any server replica can answer it — required when running
# more than one copy behind a load balancer. Set to false to pin an
# MCP session to one server process (single-instance setups only).
# MCP_STATELESS_HTTP=true

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO).
# Use DEBUG to see per-document indexing details and tool call arguments.
# MCP_LOG_LEVEL=INFO

# -- Data layer --
# Datasets are served from an embedded DuckDB database that persists
# between restarts; source data is re-ingested only when it changes.
# Deleting the file is always safe (rebuilt from source on next start).
# MCP_DB_PATH=/absolute/path/to/.mcp_data.duckdb   (default: <docs dir>/.mcp_data.duckdb)

# Where rows come from. csv (default): every *.csv under the docs dir,
# as before. parquet: named Parquet exports (the production path --
# e.g. Spark jobs writing to Azure Storage, staged locally with az cli;
# see docs/P0.md section 11.9).
# MCP_DATA_SOURCE=csv

# parquet mode only: comma-separated Name=location pairs. The Name
# becomes the dataset name the agent sees; location is a glob, a
# directory (auto-expands to dir/*.parquet -- Spark writes a folder of
# part-*.parquet files), or a single file. Globs skip the _SUCCESS /
# _committed_* marker files automatically.
# MCP_PARQUET_SOURCES=Resources=/data/Resource.parquet/*.parquet,Entitlements=/data/entitlement.parquet

# Background staleness check interval in minutes; a reload happens
# only when the source data actually changed. 0 disables the sweeper
# (the startup check still runs).
# MCP_DATA_REFRESH_MINUTES=15

# Full-text search size gate: datasets with more rows than this get
# no BM25 index, and search_dataset returns guidance to use the
# filter/count tools instead.
# MCP_SEARCH_MAX_ROWS=50000

# -- Authentication (HTTP transports only) --
# Agents connecting over sse / streamable-http must present a bearer
# token. static (default) fails closed: the server refuses to start
# without MCP_AUTH_TOKENS. Set MCP_AUTH=none to run open (local
# development only). stdio needs no auth (no HTTP layer).
# MCP_AUTH=static

# One name:token pair per agent deployment, comma-separated. The name
# is a server-side label: it appears in tool-call audit logs and lets
# you revoke one agent without rotating the others. Clients only ever
# send the token (set MCP_SERVER_TOKEN in the agent's .env).
# MCP_AUTH_TOKENS=agnes:change-me-1,another-agent:change-me-2
