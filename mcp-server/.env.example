# Path to the directory containing PDF documentation files.
# Defaults to the docs/ directory next to this file if not set.
# MCP_DOCS_DIR=/absolute/path/to/your/docs

# Server name — the identifier clients use to connect to this server.
# MCP_SERVER_NAME=access-governance-docs

# Transport mode: "stdio", "sse", or "streamable-http".
# stdio  — agent and server on the same machine (default)
# sse    — agent and server on different machines (HTTP + Server-Sent Events)
# MCP_TRANSPORT=stdio

# Host and port for SSE / Streamable HTTP transport (ignored for stdio).
# Set host to 0.0.0.0 to accept connections from other machines.
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO).
# Use DEBUG to see per-document indexing details and tool call arguments.
# MCP_LOG_LEVEL=INFO
