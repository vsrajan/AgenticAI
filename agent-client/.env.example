# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Agent Logging (DEBUG, INFO, WARNING, ERROR)
AGENT_LOG_LEVEL=INFO

# Conversation history — max messages kept in context (0 = unlimited).
# Each user turn produces ~4-6 messages (human + tool calls/results + answer),
# so 20 ≈ 3-4 full turns of context. Increase for longer conversations,
# decrease to save tokens.
KEEP_LAST_N_MSGS=20

# -- MCP Server Connection --
# On THIS branch the default is stdio: the agent starts the MCP server
# as a CHILD PROCESS and talks to it over pipes, so there is no port to
# authenticate. See docs/single-container-stdio.md.
#
# A LOCAL LABEL for this connection, nothing more. It is the key of
# the connection dict the adapter is handed, and it shows up in log
# lines. It does NOT have to match anything on the server, is not sent
# in any handshake, and is never imported as a module -- leaving it
# unset is fine. What actually STARTS the server is
# MCP_SERVER_COMMAND + MCP_SERVER_ARGS below.
MCP_SERVER_NAME=access-governance-docs

# Transport: "stdio" (default here), "streamable-http", or "sse" (legacy)
MCP_TRANSPORT=stdio

# --- stdio transport (the agent spawns the server) ---
# MCP_SERVER_ARGS is split on whitespace. Use an ABSOLUTE --project
# path so the child resolves the mcp-server environment regardless of
# the working directory the agent was started from. --no-sync stops uv
# re-resolving on every spawn.
MCP_SERVER_COMMAND=uv
MCP_SERVER_ARGS=run --no-sync --project /absolute/path/to/mcp-server mcp-docs-server

# --- streamable-http transport (connect to a running server over HTTP) ---
# The split topology, for when Entra/OAuth lands (single-container-stdio.md
# section 10). One plain HTTP endpoint; the server mounts it at /mcp.
# MCP_TRANSPORT=streamable-http
# MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# --- sse transport (legacy HTTP; kept for rollback) ---
# MCP_TRANSPORT=sse
# MCP_SERVER_URL=http://127.0.0.1:8000/sse

# bearer token identifying this agent deployment to the MCP server.
# UNUSED on stdio -- there is no HTTP layer to authenticate. Required
# only on the HTTP transports, when the server runs with
# MCP_AUTH=static. Set the real value in .env, never here:
# MCP_SERVER_TOKEN=your-mcp-token

# -- MCP SERVER settings, read by the spawned child --
# On stdio the child INHERITS this process's environment, so the
# server's own settings belong here and one .env configures both
# halves. That inheritance is NOT the MCP SDK's default -- left alone
# it forwards only HOME/PATH/SHELL/TERM/USER/LOGNAME and drops every
# MCP_* key; _get_mcp_server_config passes the environment explicitly
# to make this work. Precedence is shell env > agent-client/.env >
# mcp-server/.env, and load_dotenv never overrides what is already
# set -- so anything listed here SHADOWS the same key in
# mcp-server/.env, silently. Keep each MCP setting in exactly one of
# the two files. (In the container there is no .env at all: every
# value arrives from the pod spec.)
#
# Absolute paths, always -- a relative path resolves against whatever
# directory the agent process was started from.
# MCP_DOCS_DIR=/absolute/path/to/mcp-server/docs
# MCP_DB_PATH=/absolute/path/to/mcp-server/.mcp_data.duckdb
# MCP_LOG_LEVEL=INFO
#
# Data source: csv (default) or parquet. In parquet mode
# MCP_PARQUET_SOURCES is required -- comma-separated Name=location
# pairs, absolute paths.
# MCP_DATA_SOURCE=parquet
# MCP_PARQUET_SOURCES=Resources=/abs/export/Resource.parquet,Entitlements=/abs/export/entitlement.parquet

# Tool result size -- max characters kept per tool response (0 = unlimited).
# MCP tools can return very large results that exceed OpenAI's content-array
# limit. This caps the text length sent to the LLM per tool call.
MAX_TOOL_CONTENT_LEN=80000

# -- Agent API server --
# Settings for the HTTP API (uv run agent-api). See README_api.md and
# docs/agent_api.md.

# auth mode: static (default, requires AGENT_API_TOKEN) or none (local
# dev only -- runs the API without authentication)
AGENT_API_AUTH=static

# shared bearer token for static mode. Intentionally left unset in this
# template so the server fails closed instead of starting with a known
# default token. Uncomment and set a real value in your .env copy:
# AGENT_API_TOKEN=your-secret-token

# bind address and port for the API server. 0.0.0.0 accepts
# connections from other machines (needed when the web client is
# hosted elsewhere); use 127.0.0.1 to restrict to this machine only.
AGENT_API_HOST=0.0.0.0
AGENT_API_PORT=8080

# CORS allowlist -- which web page origins a browser may call the API
# from (comma-separated). * accepts any origin: fine for local dev and
# the POC web client (webclient_api.html); tighten for real deployments.
AGENT_API_CORS_ORIGINS=*

# session hygiene -- sessions live in server memory (MemorySaver), so
# idle ones are evicted to keep memory bounded. A session idle longer
# than the TTL is deleted (clients get 404 and create a new one); the
# max cap evicts the least recently used session when full.
AGENT_API_SESSION_TTL_MINUTES=60
AGENT_API_MAX_SESSIONS=500

# graph execution log -- every node's output is appended per turn,
# tagged with the session id, same format as the CLI's agent_stream.txt
# (tail -f for live visibility). Reset on server start. Set to an
# empty value to disable.
AGENT_API_STREAM_FILE=agent_api_stream.txt

# -- session state store (P3.1) --
# LEAVE UNSET on this branch: there is no Redis on the infrastructure,
# which is why the deployment runs a single pod (docs/single-agent.md).
#
# Unset (default): sessions, locks, and conversation history live in
# process memory -- lost on restart, and the API must run as a SINGLE
# instance. Set to a Redis URL to move all three into Redis: sessions
# survive restarts and any number of agent-api instances can share the
# same session pool (required before running replicas > 1).
# The URL carries everything -- password, TLS, port, db:
#   local dev:    redis://localhost:6379/0
#   with password: redis://:password@host:6379/0
#   Azure Cache:  rediss://:<access-key>@<name>.redis.cache.windows.net:6380/0
# The URL contains a secret -- set the real value only in .env, never here.
# REDIS_URL=redis://localhost:6379/0

# turn-lock timeout; must exceed the longest realistic turn.
# In Redis mode it is the lock's TTL, so a crashed instance's lock
# frees itself after this long. In memory mode (this branch) it bounds
# how long a second message on the same session waits for the running
# turn before being rejected, and marks a lock held longer than this
# as STUCK so the session can still be evicted.
# AGENT_API_LOCK_TIMEOUT_SECONDS=300
