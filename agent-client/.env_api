# -- Agent framework + API configuration (template) --
#
# Complete configuration for running the agent framework through the API
# server (cli_api.py): Azure OpenAI, agent behavior, MCP connection, and
# the API-specific settings. Superset of .env.example.
#
# This file IS committed to git (the .gitignore only covers .env), so it
# must contain placeholders only -- never real secrets. Put real values
# in the gitignored .env or in the shell environment; cli_api.py loads
# .env first and this file never overrides variables already set.

# -- Azure OpenAI --
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# -- Agent behavior --

# logging (DEBUG, INFO, WARNING, ERROR)
AGENT_LOG_LEVEL=INFO

# conversation history -- max messages kept in context (0 = unlimited).
# Each user turn produces ~4-6 messages (human + tool calls/results +
# answer), so 20 ~ 3-4 full turns of context. Increase for longer
# conversations, decrease to save tokens.
KEEP_LAST_N_MSGS=20

# tool result size -- max characters kept per tool response (0 = unlimited).
# MCP tools can return very large results that exceed OpenAI's
# content-array limit. This caps the text length sent to the LLM per
# tool call.
MAX_TOOL_CONTENT_LEN=80000

# -- MCP server connection --
# The MCP server must be started separately before running the API.

# server name (must match the name registered on the MCP server)
MCP_SERVER_NAME=access-governance-docs

# transport: "sse" (default) or "stdio"
MCP_TRANSPORT=sse

# sse transport (connect to a running server over HTTP)
MCP_SERVER_URL=http://127.0.0.1:8000/sse

# stdio transport (pipe to a local command) -- uncomment to use
# MCP_TRANSPORT=stdio
# MCP_SERVER_COMMAND=uv
# MCP_SERVER_ARGS=run --directory /path/to/mcp-server mcp-docs-server

# -- API server --

# auth mode: static (default, requires AGENT_API_TOKEN) or none (local
# dev only -- runs the API without authentication)
AGENT_API_AUTH=static

# shared bearer token for static mode. Intentionally left unset here so
# the server fails closed instead of starting with a known default token.
# Set it in .env or the shell env:
# AGENT_API_TOKEN=your-secret-token

# bind address and port for the API server
AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=8080

# -- MCP server process (reference only) --
# These are read by the MCP server from mcp-server/.env, NOT from this
# file -- listed here so the whole framework's knobs are in one place.
# See mcp-server/.env.example for details.
# MCP_DOCS_DIR=/absolute/path/to/your/docs
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_LOG_LEVEL=INFO
